    "test": "jest",
    "testWorld": "node tests/script/copy-world.mjs",
    "lint:html": "eslint ./scripts ./tests -f html -o eslint-report.html"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.4",
    "@foundryvtt/foundryvtt-cli": "^1.0.0-rc.4",
    "@types/node": "^24.3.1",
    "babel-core": "^7.0.0-bridge.0",
    "eslint": "^9.13.0",
    "eslint-formatter-html": "^2.7.2",
    "fancy-log": "^2.0.0",
    "jest": "^29.7.0",
    "yargs": "^17.7.2"
  },
  "dependencies": {
    "fs-extra": "^11.2.0"
  },
  "jest": {
    "setupFiles": [
      "./jest.setup.js"
    ],
    "transform": {
      "^.+\\.m?[tj]s$": "babel-jest"
    }
