{
  "scripts": {
    "build": "npm run build:generateCards && npm run build:db",
    "build:db": "node ./utils/packs.mjs package pack",
    "build:generateCards": "node utils/create_cards_by_classes_and_level.js",
    "build:json": "node ./utils/packs.mjs package unpack",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "testWorlds": "npm run testWorld:blank && npm run testWorld:lyrkhan",
    "testWorld:blank": "node tests/script/copy-world.mjs blank-world",
    "testWorld:lyrkhan": "node tests/script/copy-world.mjs lyrkhan-world",
    "lint": "eslint ./scripts ./tests",
    "lint:fix": "eslint ./scripts ./tests --fix",
    "lint:html": "eslint ./scripts ./tests -f html -o eslint-report.html"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@foundryvtt/foundryvtt-cli": "^1.0.0-rc.4",
    "@types/node": "^24.3.1",
    "@vitest/coverage-v8": "^4.1.0",
    "babel-core": "^7.0.0-bridge.0",
    "eslint": "^9.26.0",
    "eslint-formatter-html": "^2.7.2",
    "fancy-log": "^2.0.0",
    "jsdom": "^29.0.1",
    "vitest": "^4.1.0",
    "yargs": "^17.7.2"
  },
  "dependencies": {
    "fs-extra": "^11.2.0"
  },
  "jest": {
    "setupFiles": [
      "./jest.setup.js"
    ],
    "transform": {
      "^.+\\.m?[tj]s$": "babel-jest"
    }
  }
}
