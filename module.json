  "compatibility": {
    "minimum": "14",
    "verified": "14.365"
  },
  "relationships": {
    "systems": [
      {
        "id": "dnd5e",
        "type": "system",
        "compatibility": {
          "minimum": "5.3.0",
          "verified": "5.3.3",
          "maximum": "5.9.99"
        }
      }
    ],
    "requires": [
      {
        "id": "socketlib",
        "type": "module",
        "compatibility": {
          "minimum": "1.1.0",
          "verified": "1.1.4",
          "maximum": "1.9.99"
        }
      },
      {
        "id": "lib-wrapper",
        "type": "module",
        "compatibility": {
          "minimum": "1.13.4.0",
          "verified": "1.13.5.1",
          "maximum": "1.99.99.99"
        }
      }
    ],
    "recommends": [
      {
        "id": "orcnog-card-viewer",
        "type": "module",
        "reason": "The Card module viewer enhanced quality of drawing cards",
        "compatibility": {
        }
      },
      {
        "id": "sequencer",
        "type": "module",
        "reason": "The Sequencer module provides beautiful visuals effects implemented with FQ cards",
        "compatibility": {
        }
      },
      {
        "id": "JB2A_DnD5e",
        "type": "module",
        "reason": "The JB2A module is used with Sequencer",
        "compatibility": {
        }
      },
      {
        "id": "dae",
        "type": "module",
        "reason": "The DAE module is used with to make actor's effect with visual FX",
        "compatibility": {
        }
      }
    ]
  },
