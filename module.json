{
  "id": "fq-card-engine",
  "title": "FQ Card Engine",
  "description": "Module for Final Quest 8 Battle system with hand window for displaying cards",
  "version": "2.0.0",
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json",
      "flags": {}
    },
    {
      "lang": "fr",
      "name": "Français",
      "path": "lang/fr.json",
      "flags": {}
    }
  ],
  "authors": [
    {
      "name": "Lyrkhan",
      "email": "lyrkhanjenkins@gmail.com",
      "url": "https://gitlab.com/lyrkhanjenkins",
      "discord": "lyrkhanjenkins",
      "flags": {}
    }
  ],
  "esmodules": [
    "src/init-engine.js",
    "src/hook/socket-lib.js",
    "src/hook/combat.js",
    "src/hook/trading-cards.js",
    "src/hook/render-token.js",
    "src/hook/item-use.js"
  ],
  "styles": [
    "styles/globals.css",
    "styles/fq-card-engine.css",
    "styles/fq-dnd5e-sheet.css"
  ],
  "socket": true,
  "url": "https://gitlab.com/final-quest/fq-card-engine",
  "manifest": "https://gitlab.com/final-quest/fq-card-engine/-/raw/final-quest-8/module.json",
