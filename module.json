  "esmodules": [
    "src/init-engine.js",
    "src/hook/init.hook.js",
    "src/hook/setup.hook.js",
    "src/hook/render-game-pause.hook.js",
    "src/hook/integration/socketlib.hook.js",
    "src/hook/integration/sequencer.hook.js",
    "src/hook/integration/dnd5e.hook.js",
    "src/hook/combat.hook.js",
    "src/hook/reaction.hook.js",
    "src/hook/prepared-card.hook.js",
    "src/hook/trading-cards.hook.js",
    "src/hook/render-token.hook.js",
    "src/hook/item.hook.js"
  ],
  "styles": [
    "styles/globals.css",
    "styles/card-engine/root.css",
    "styles/card-engine/toolbar.css",
    "styles/card-engine/hand.css",
    "styles/card-engine/card.css",
    "styles/card-engine/chat.css",
    "styles/card-engine/utilities.css",
    "styles/card-engine/dialog-play.css",
    "styles/card-engine/draw-reveal.css",
    "styles/card-engine/card-selection.css",
    "styles/card-engine/spellbook-window.css",
    "styles/card-engine/result-window.css",
    "styles/fq-dnd5e-sheet.css"
  ],
  "socket": true,
  "url": "https://gitlab.com/final-quest/fq-card-engine",
  "manifest": "https://gitlab.com/final-quest/fq-card-engine/-/raw/final-quest-8/module.json",
  "download": "https://gitlab.com/final-quest/fq-card-engine/-/jobs/15814816078/artifacts/raw/fq-card-engine.zip",
  "compatibility": {
    "minimum": "14",
    "verified": "14.368"
  },
  "relationships": {
    "systems": [
      {
        "id": "dnd5e",
        "type": "system",
        "compatibility": {
          "minimum": "6.0.0",
          "verified": "6.0.3",
          "maximum": "6.9.99"
        }
      }
    ],
    "requires": [
      {
        "id": "socketlib",
        "type": "module",
        "compatibility": {
          "minimum": "1.1.0",
          "verified": "1.1.4"
        }
      },
      {
        "id": "lib-wrapper",
        "type": "module",
        "compatibility": {
          "minimum": "1.13.4.0",
          "verified": "1.13.5.1"
        }
      },
      {
        "id": "dae",
        "type": "module",
        "reason": "The DAE module executes effect macros (macro.execute).",
        "compatibility": {
          "minimum": "14.0.0",
          "verified": "14.0.14"
        }
      }
    ],
    "recommends": [
      {
        "id": "sequencer",
        "type": "module",
        "reason": "The Sequencer module provides beautiful visuals effects implemented with FQ cards",
        "compatibility": {
          "minimum": "4.0.0",
          "verified": "4.2.3"
        }
      },
      {
        "id": "JB2A_DnD5e",
        "type": "module",
        "reason": "The JB2A module is used with Sequencer",
        "compatibility": {
          "minimum": "0.9.0",
          "verified": "0.9.2"
        }
      },
      {
        "id": "fq-restrain-movement",
        "type": "module",
        "reason": "This module restricts the movement of players' tokens.",
        "compatibility": {
          "minimum": "3.0.0",
          "verified": "3.0.0"
        }
      }
    ]
  },
