      "path": "lang/en.json",
      "flags": {}
    },
    {
      "lang": "fr",
      "name": "Français",
      "path": "lang/fr.json",
      "flags": {}
    }
  ],
  "authors": [
    {
      "name": "Lyrkhan",
      "email": "lyrkhanjenkins@gmail.com",
      "url": "https://gitlab.com/lyrkhanjenkins",
      "discord": "lyrkhanjenkins",
      "flags": {}
    }
