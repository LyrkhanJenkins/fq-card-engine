<div
        class="fq-card fq-card-engine-card{{#if isFQBase}} fq-card-is-base
                {{/if}}{{#if passiveHasBeenPlayedOnRound}} has-been-played-on-round{{ else }}{{#if
                hasBeenPlayed}} has-been-played
                {{/if}}{{/if}}{{#if isGenerated}} fq-card--generated{{/if}}{{#if back}} fq-card--back{{/if}}"
        data-card-id="{{ id }}"
        data-card-uuid="{{ uuid }}"
        data-cards-id="{{ cardsid }}"
        title="{{ name }}"
        draggable="true"
>
    <div class="fq-card-inner">

        {{#if back}}
            <div class="fq-card-face" style="background-image: url('{{ img }}')"></div>
        {{ else }}
            <div id="fq-card-engine-card-image">
                {{> "modules/fq-card-engine/src/templates/partials/card-svg.hbs"
                        img=img
                        name=name
                        action=action
                        mana=mana
                        zeal=zeal
                        minReach=minReach
                        maxReach=maxReach
                        maxSameCard=maxSameCard
                        fqClass=fqClass
                        description=description
                        titleSize=titleSize
                        descriptionSize=descriptionSize
                        reactive=reactive
                        replayable=replayable
                }}
            </div>
        {{/if}}

        {{#if isFQBase}}
            <span class="fq-card-badge fq-card-badge--base">Base</span>
        {{/if}}
    </div>

    <span class="fq-card-tooltip">{{ localize name }}</span>

</div>
</div>
