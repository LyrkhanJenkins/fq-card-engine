<div
        class="fq-card fq-card-engine-card{{#if isFQBase}} fq-card--base fq-card-is-base
                {{/if}}{{#if hasBeenPlayedOnRound}} fq-card--exhausted has-been-played-on-round{{ else }}{{#if
                hasBeenPlayed}} fq-card--played has-been-played
                {{/if}}{{/if}}{{#if back}} fq-card--back{{/if}}"
        data-card-id="{{ id }}"
        data-card-uuid="{{ uuid }}"
        data-cards-id="{{ cardsid }}"
        title="{{ name }}"
        draggable="true"
>
    <div class="fq-card-inner">

        {{#if back}}
            <div class="fq-card-face" style="background-image: url('{{ img }}')"></div>
        {{ else }}
            <div id="fq-card-engine-card-image">
                {{> "modules/fq-card-engine/src/templates/partials/card-svg.hbs"
                        img=img
                        name=name
                        action=action
                        mana=mana
                        zeal=zeal
                        minReach=minReach
                        maxReach=maxReach
                        maxSameCard=maxSameCard
                        fqClass=fqClass
                        description=description
                        titleSize=titleSize
                        descriptionSize=descriptionSize
                        reactive=reactive
                        replayable=replayable
                }}
            </div>
        {{/if}}

        {{#if isFQBase}}
            <span class="fq-card-badge fq-card-badge--base">Base</span>
        {{/if}}

        {{#if hasBeenPlayedOnRound}}
            <span class="fq-card-badge fq-card-badge--exhausted">
                <svg viewBox="0 0 10 10" fill="none" xmlns="http://www.w3.org/2000/svg" width="8" height="8">
                    <path d="M9 3C9 3 8 1 5 1C2.5 1 1 3 1 5C1 7.5 3 9 5.5 9" stroke="currentColor" stroke-width="1.2"
                          stroke-linecap="round"/>
                    <path d="M6.5 7L9 9.5M9 7L6.5 9.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
                </svg>
            </span>
        {{ else }}
            {{#if hasBeenPlayed}}
                <span class="fq-card-badge fq-card-badge--played">
                <svg viewBox="0 0 10 8" fill="none" xmlns="http://www.w3.org/2000/svg" width="8" height="8">
                    <path d="M1 4L3.5 6.5L9 1" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"
                          stroke-linejoin="round"/>
                </svg>
            </span>
            {{/if}}
        {{/if}}
    </div>

    <span class="fq-card-tooltip">{{ localize name }}</span>

</div>
</div>
