<div id="fq-card-engine-container">

    <div class="fq-top-bar">
        <span class="fq-move-handle fq-card-engine-move-handle" title="{{ localize 'FQCARDENGINE.Move'}}">
            <span class="fq-move-pip"></span>
            <span class="fq-move-pip"></span>
            <span class="fq-move-pip"></span>
        </span>
    </div>

    <div id="fq-card-engine-hands-container"></div>

    <div class="fq-toolbar fq-card-engine-buttons-container">

        <button class="fq-toolbar-btn fq-card-engine-hide-show fq-hide-show"
                title="{{ localize 'FQCARDENGINE.HideShow'}}">
            <svg class="fq-chevron-icon" viewBox="0 0 10 6" fill="none" xmlns="http://www.w3.org/2000/svg" width="10"
                 height="10">
                <path d="M1 5L5 1L9 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"
                      stroke-linejoin="round"/>
            </svg>
        </button>

        {{#if isGM}}
            <button class="fq-toolbar-btn fq-card-engine-subtract-bar" title="{{ localize 'FQCARDENGINE.RemoveBar'}}">
                <svg viewBox="0 0 10 2" fill="none" xmlns="http://www.w3.org/2000/svg" width="10" height="10">
                    <path d="M1 1H9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                </svg>
            </button>

            <button class="fq-toolbar-btn fq-card-engine-add-bar" title="{{ localize 'FQCARDENGINE.AddBar'}}">
                <svg viewBox="0 0 10 10" fill="none" xmlns="http://www.w3.org/2000/svg" width="10" height="10">
                    <path d="M5 1V9M1 5H9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                </svg>
            </button>
        {{/if}}

        <div class="fq-size-control">
            <svg viewBox="0 0 8 10" fill="none" xmlns="http://www.w3.org/2000/svg" width="8" height="10"
                 class="fq-size-icon-sm">
                <rect x="1" y="3" width="6" height="7" rx="1" stroke="currentColor" stroke-width="1"/>
            </svg>
            <input type="range" class="fq-size-slider" id="fq-size-slider"
                   min="0.6" max="2.6" step="0.05" value="1.0"
                   title="{{ localize 'FQCARDENGINE.CardSize'}}"/>
            <svg viewBox="0 0 10 12" fill="none" xmlns="http://www.w3.org/2000/svg" width="10" height="12"
                 class="fq-size-icon-lg">
                <rect x="1" y="2" width="8" height="10" rx="1" stroke="currentColor" stroke-width="1"/>
            </svg>
        </div>

        <div class="fq-toolbar-sep"></div>

        <button class="fq-toolbar-btn fq-char-gauges-toggle" id="fq-char-gauges-toggle"
                title="{{ localize 'FQCARDENGINE.HideShow'}}">
            <svg class="fq-char-gauges-chevron" viewBox="0 0 6 10" fill="none" xmlns="http://www.w3.org/2000/svg"
                 width="6" height="10">
                <path d="M1 1L5 5L1 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"
                      stroke-linejoin="round"/>
            </svg>
        </button>

        <div class="fq-char-gauges" id="fq-char-gauges">
            <div class="fq-cg-avatar-wrap">
                <img class="fq-cg-avatar" id="fq-cg-avatar" src="" alt=""/>
            </div>
            <div class="fq-cg-bars">
                <div class="fq-cg-bar" title="HP">
                    <span class="fq-cg-icon fq-gauge-hp">♥</span>
                    <div class="fq-cg-track">
                        <div class="fq-cg-fill fq-gauge-fill-hp" id="fq-cg-hp"></div>
                    </div>
                    <span class="fq-cg-val" id="fq-cg-hp-val">–</span>
                </div>
                <div class="fq-cg-bar" title="Action">
                    <span class="fq-cg-icon fq-gauge-action">⚡</span>
                    <div class="fq-cg-track">
                        <div class="fq-cg-fill fq-gauge-fill-action" id="fq-cg-action"></div>
                    </div>
                    <span class="fq-cg-val" id="fq-cg-action-val">–</span>
                </div>
                <div class="fq-cg-bar" title="Mana">
                    <span class="fq-cg-icon fq-gauge-mana">✦</span>
                    <div class="fq-cg-track">
                        <div class="fq-cg-fill fq-gauge-fill-mana" id="fq-cg-mana"></div>
                    </div>
                    <span class="fq-cg-val" id="fq-cg-mana-val">–</span>
                </div>
                <div class="fq-cg-bar" title="Zeal">
                    <span class="fq-cg-icon fq-gauge-zeal">☀</span>
                    <div class="fq-cg-track">
                        <div class="fq-cg-fill fq-gauge-fill-zeal" id="fq-cg-zeal"></div>
                    </div>
                    <span class="fq-cg-val" id="fq-cg-zeal-val">–</span>
                </div>
            </div>
            <div class="fq-cg-chips">
                <span class="fq-cg-chip fq-gauge-critical" id="fq-cg-critical-chip"
                      title="{{ localize 'FQCARDENGINE.CriticalScore' }}">
                    <span class="fq-cg-chip-icon">💥</span>
                    <span class="fq-cg-chip-val" id="fq-cg-critical">–</span>
                </span>
                <span class="fq-cg-chip fq-gauge-evasion" id="fq-cg-evasion-chip"
                      title="{{ localize 'FQCARDENGINE.EvasionScore' }}">
                    <span class="fq-cg-chip-icon">💨</span>
                    <span class="fq-cg-chip-val" id="fq-cg-evasion">–</span>
                </span>
                <span class="fq-cg-chip fq-gauge-drop" id="fq-cg-drop-chip"
                      title="{{ localize 'FQCARDENGINE.DropScore' }}">
                    <span class="fq-cg-chip-icon">🗑</span>
                    <span class="fq-cg-chip-val" id="fq-cg-drop">–</span>
                </span>
                <span class="fq-cg-chip fq-gauge-sacrifice" id="fq-cg-sacrifice-chip" style="display:none"
                      title="{{ localize 'FQCARDENGINE.SacrificedSkeleton' }}">
                    <span class="fq-cg-chip-icon">💀</span>
                    <span class="fq-cg-chip-val" id="fq-cg-sacrifice">–</span>
                </span>
                <span class="fq-cg-chip fq-gauge-range" id="fq-cg-range-chip" style="display:none"
                      title="{{ localize 'FQCARDENGINE.RangeBonus' }}">
                    <span class="fq-cg-chip-icon">🏹</span>
                    <span class="fq-cg-chip-val" id="fq-cg-range">–</span>
                </span>
                <span class="fq-cg-chip fq-gauge-damage" id="fq-cg-damage-chip" style="display:none"
                      title="{{ localize 'FQCARDENGINE.DamageBonus' }}">
                    <span class="fq-cg-chip-icon">⚔</span>
                    <span class="fq-cg-chip-val" id="fq-cg-damage">–</span>
                </span>
                <span class="fq-cg-chip fq-gauge-heal" id="fq-cg-heal-chip" style="display:none"
                      title="{{ localize 'FQCARDENGINE.HealBonus' }}">
                    <span class="fq-cg-chip-icon">💚</span>
                    <span class="fq-cg-chip-val" id="fq-cg-heal">–</span>
                </span>
            </div>
        </div>

    </div>

</div>
