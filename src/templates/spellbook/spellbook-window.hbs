<div class="fq-spellbook-body">
    {{#if combatLocked}}
        <div class="fq-spellbook-combat-banner">
            <i class="fa-solid fa-lock"></i>
            <span>{{localize "FQCARDENGINE.SpellBookCombatLockedBanner"}}</span>
        </div>
    {{/if}}
    {{#unless isEmpty}}
        <div class="fq-spellbook-toolbar">
            <div class="fq-spellbook-filter" data-tooltip="{{localize "FQCARDENGINE.SpellBookFilterClassLabel"}}">
                <i class="fa-solid fa-user-shield"></i>
                <select name="classKey">
                    <option value="" selected>{{localize "FQCARDENGINE.SpellBookFilterClassAll"}}</option>
                    {{#each groups}}
                        <option value="{{classKey}}">{{classLabel}}</option>
                    {{/each}}
                </select>
            </div>
            <div class="fq-spellbook-filter" data-tooltip="{{localize "FQCARDENGINE.SpellBookFilterLevelLabel"}}">
                <i class="fa-solid fa-arrow-up-1-9"></i>
                <select name="level">
                    <option value="" selected>{{localize "FQCARDENGINE.SpellBookFilterLevelAll"}}</option>
                    {{#each levelOptions}}
                        <option value="{{this}}">{{this}}</option>
                    {{/each}}
                </select>
            </div>
            <div class="fq-spellbook-filter" data-tooltip="{{localize "FQCARDENGINE.SpellBookFilterSearchLabel"}}">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input type="search" name="search" placeholder="{{localize "FQCARDENGINE.SpellBookFilterSearchPlaceholder"}}">
            </div>
            <button type="button" class="fq-spellbook-filters-reset" data-action="fqResetFilters">
                <i class="fa-solid fa-xmark"></i>
                <span>{{localize "FQCARDENGINE.SpellBookFiltersReset"}}</span>
            </button>
            <span class="fq-spellbook-deck-size" data-tooltip="{{localize "FQCARDENGINE.SpellBookDeckSizeTooltip"}}">
                <i class="fa-solid fa-layer-group"></i>
            </span>
        </div>
    {{/unless}}
    <div class="fq-spellbook-content">
        <div class="fq-spellbook-grid">
            {{#if isEmpty}}
                <div class="fq-spellbook-empty">
                    <p class="fq-spellbook-empty-title">{{localize "FQCARDENGINE.SpellBookEmptyTitle"}}</p>
                    <p class="fq-spellbook-empty-body">{{localize "FQCARDENGINE.SpellBookEmptyBody"}}</p>
                </div>
            {{else}}
                {{#each groups}}
                    <div class="fq-spellbook-group">
                        <div class="fq-spellbook-group-header" data-tooltip="{{localize "FQCARDENGINE.SortedByLevel"}}">
                            <span class="fq-spellbook-group-title">{{classLabel}}</span>
                            <span class="fq-spellbook-group-count">({{count}})</span>
                        </div>
                        <div class="fq-spellbook-cards" data-spellbook-cards="{{classKey}}"></div>
                    </div>
                {{/each}}
                <div class="fq-spellbook-no-results" hidden>
                    <p class="fq-spellbook-no-results-title">{{localize "FQCARDENGINE.SpellBookNoResultsTitle"}}</p>
                    <p class="fq-spellbook-no-results-body">{{localize "FQCARDENGINE.SpellBookNoResultsBody"}}</p>
                    <button type="button" class="fq-spellbook-no-results-reset" data-action="fqResetFilters">
                        {{localize "FQCARDENGINE.SpellBookFiltersReset"}}
                    </button>
                </div>
            {{/if}}
        </div>
        {{#unless isEmpty}}
            <div class="fq-spellbook-preview">
                <div class="fq-spellbook-preview-content">
                    <div class="fq-spellbook-preview-empty">
                        <i class="fa-solid fa-hand-pointer fa-2x"></i>
                        <span>{{localize "FQCARDENGINE.SpellBookPreviewInvite"}}</span>
                    </div>
                </div>
            </div>
        {{/unless}}
    </div>
    <div class="fq-spellbook-help">{{localize "FQCARDENGINE.SpellBookHelpLine"}}</div>
</div>
