<div class="fq-play-dialog">
    {{!-- Jauges personnage (gauche) --}}
    {{#if charStats}}
        <div class="fq-play-charStats">
            <div class="fq-play-char-header">
                <img class="fq-play-char-img" src="{{charStats.img}}" alt="{{charStats.name}}"/>
                <span class="fq-play-char-name">{{charStats.name}}</span>
            </div>

            <div class="fq-play-gauge">
                <span class="fq-play-gauge-label fq-gauge-hp">❤</span>
                <div class="fq-play-gauge-bar">
                    <div class="fq-play-gauge-fill fq-gauge-fill-hp" style="width: {{charStats.hpPct}}%"></div>
                </div>
                <span class="fq-play-gauge-val">{{charStats.hpValue}}/{{charStats.hpMax}}</span>
            </div>

            <div class="fq-play-gauge">
                <span class="fq-play-gauge-label fq-gauge-action">⚡</span>
                <div class="fq-play-gauge-bar">
                    <div class="fq-play-gauge-fill fq-gauge-fill-action" style="width: {{charStats.actionPct}}%"></div>
                </div>
                <span class="fq-play-gauge-val">{{charStats.actionValue}}/{{charStats.actionMax}}</span>
            </div>

            <div class="fq-play-gauge">
                <span class="fq-play-gauge-label fq-gauge-mana">✦</span>
                <div class="fq-play-gauge-bar">
                    <div class="fq-play-gauge-fill fq-gauge-fill-mana" style="width: {{charStats.manaPct}}%"></div>
                </div>
                <span class="fq-play-gauge-val">{{charStats.manaValue}}/{{charStats.manaMax}}</span>
            </div>

            <div class="fq-play-gauge">
                <span class="fq-play-gauge-label fq-gauge-zeal">☀</span>
                <div class="fq-play-gauge-bar">
                    <div class="fq-play-gauge-fill fq-gauge-fill-zeal" style="width: {{charStats.zealPct}}%"></div>
                </div>
                <span class="fq-play-gauge-val">{{charStats.zealValue}}/{{charStats.zealMax}}</span>
            </div>

            {{!-- Statistiques secondaires (pastilles) --}}
            <div class="fq-play-chips">
                <span class="fq-play-chip fq-gauge-critical" title="{{ localize 'FQCARDENGINE.CriticalScore' }}">
                    <span class="fq-play-chip-icon">💥</span>
                    <span class="fq-play-chip-val">{{charStats.critical}}</span>
                </span>
                <span class="fq-play-chip fq-gauge-evasion" title="{{ localize 'FQCARDENGINE.EvasionScore' }}">
                    <span class="fq-play-chip-icon">💨</span>
                    <span class="fq-play-chip-val">{{charStats.evasion}}</span>
                </span>
                <span class="fq-play-chip fq-gauge-drop" title="{{ localize 'FQCARDENGINE.DropScore' }}">
                    <span class="fq-play-chip-icon">🗑</span>
                    <span class="fq-play-chip-val">{{charStats.currentDrop}}</span>
                </span>
                {{#if charStats.showSacrifice}}
                    <span class="fq-play-chip fq-gauge-sacrifice"
                          title="{{ localize 'FQCARDENGINE.SacrificedMinion' }}">
                        <span class="fq-play-chip-icon">💀</span>
                        <span class="fq-play-chip-val">{{charStats.sacrificedMinion}}</span>
                    </span>
                {{/if}}
                {{#if charStats.showRangeBonus}}
                    <span class="fq-play-chip fq-gauge-range" title="{{ localize 'FQCARDENGINE.RangeBonus' }}">
                        <span class="fq-play-chip-icon">🏹</span>
                        <span class="fq-play-chip-val">{{charStats.rangeBonus}}</span>
                    </span>
                {{/if}}
                {{#if charStats.showDamageBonus}}
                    <span class="fq-play-chip fq-gauge-damage" title="{{ localize 'FQCARDENGINE.DamageBonus' }}">
                        <span class="fq-play-chip-icon">⚔</span>
                        <span class="fq-play-chip-val">{{charStats.damageBonus}}</span>
                    </span>
                {{/if}}
                {{#if charStats.showHealBonus}}
                    <span class="fq-play-chip fq-gauge-heal" title="{{ localize 'FQCARDENGINE.HealBonus' }}">
                        <span class="fq-play-chip-icon">💚</span>
                        <span class="fq-play-chip-val">{{charStats.healBonus}}</span>
                    </span>
                {{/if}}
            </div>
        </div>
    {{/if}}


    <div class="fq-play-targets">
        <div class="fq-play-targets-content">
            {{> "modules/fq-card-engine/src/templates/partials/targeting-panel.hbs" panel}}
        </div>
    </div>

    <button class="fq-play-close" onclick="$(this).closest('.app').find('.header-button.close').trigger('click')">
        <svg viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg" width="24" height="24">
            <path d="M1 1L11 11M11 1L1 11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
    </button>
    <button class="fq-play-nav fq-play-nav--prev" data-action="prev">
        <svg viewBox="0 0 10 16" fill="none" xmlns="http://www.w3.org/2000/svg" width="20" height="32">
            <path d="M8 2L2 8L8 14" stroke="currentColor" stroke-width="3" stroke-linecap="round"
                  stroke-linejoin="round"/>
        </svg>
    </button>
    {{!-- Fond sombre avec la carte en vedette --}}
    <div class="fq-play-card-stage">

        {{!-- Carte --}}
        <div class="fq-play-card-wrap">
            <div class="fq-play-card-img{{#if back}} fq-play-card-img--back{{/if}}{{#if isFQInnate}} fq-card-is-innate{{/if}}{{#if
                    isPlayedThisRound}} has-been-played-on-round {{else}}{{#if hasBeenPlayed}} has-been-played{{/if}}{{/if}}">

                {{#if back}}
                    <div class="fq-card-face" style="background-image: url('{{ img }}')"></div>
                {{else}}
                    {{> "modules/fq-card-engine/src/templates/partials/card-svg.hbs"
                            img=img
                            name=name
                            action=action
                            mana=mana
                            zeal=zeal
                            minReach=minReach
                            maxReach=maxReach
                            maxSameCard=maxSameCard
                            fqClass=fqClass
                            description=description
                            titleSize=titleSize
                            descriptionSize=descriptionSize
                            reactive=reactive
                            replayable=replayable
                            replayableTooltip=replayableTooltip
                    }}
                {{/if}}
            </div>
            {{#if isFQInnate}}
                <span class="fq-play-badge fq-play-badge--innate">Innée</span>
            {{/if}}
            {{#if isPlayedThisRound}}
                <span class="fq-play-badge fq-play-badge--exhausted">Épuisée ce tour</span>
            {{else}}
                {{#if hasBeenPlayed}}
                    <span class="fq-play-badge fq-play-badge--played">Déjà jouée</span>
                {{/if}}
            {{/if}}
        </div>

    </div>

    <button class="fq-play-nav fq-play-nav--next" data-action="next">
        <svg viewBox="0 0 10 16" fill="none" xmlns="http://www.w3.org/2000/svg" width="20" height="32">
            <path d="M2 2L8 8L2 14" stroke="currentColor" stroke-width="3" stroke-linecap="round"
                  stroke-linejoin="round"/>
        </svg>
    </button>

    {{!-- Zone des options flottantes --}}
    <div class="fq-play-options">

        <form class="cards-dialog fq-play-form">

            {{!-- Statut --}}
            {{#if hasBeenPlayed}}
                {{#if isPlayedThisRound}}
                    <div class="fq-play-status fq-play-status--warn">
                        {{localize "FQCARDENGINE.InfoMsgSpellNotUsableThisTurn"}}
                    </div>
                {{else}}
                    <div class="fq-play-status fq-play-status--ok">
                        {{localize "FQCARDENGINE.InfoMsgSpellUsableThisTurn"}}
                    </div>
                {{/if}}
            {{/if}}

            {{!-- Cible --}}
            {{#if hasSeveralDiscards}}
                <div class="fq-play-field">
                    <label class="fq-play-label">{{localize "FQCARDENGINE.PassTo"}}</label>
                    <select name="to" class="fq-play-select">
                        {{selectOptions discards nameAttr="id" labelAttr="name" valueAttr="id"}}
                    </select>
                </div>
            {{/if}}

            {{!-- Choix d'effet --}}
            {{#if severalChoices}}
                <div class="fq-play-field">
                    <label class="fq-play-label">{{localize "FQCARDENGINE.ChooseEffect"}}</label>
                    <select name="nameContent" class="fq-play-select">
                        {{selectOptions cardContents nameAttr="name" labelAttr="localizedName" valueAttr="name"}}
                    </select>
                </div>
            {{/if}}

            {{!-- Variables X / Y --}}
            {{#if hasVariables}}
                <div class="fq-play-field fq-play-field--row">
                    {{#if hasXVariable}}
                        <label class="fq-play-label">X =
                            <input class="fq-play-input" required type="number" name="XXX"/>
                        </label>
                    {{/if}}
                    {{#if hasYVariable}}
                        <label class="fq-play-label">Y =
                            <input class="fq-play-input" required type="number" name="YYY"/>
                        </label>
                    {{/if}}
                </div>
            {{/if}}

            {{!-- Placement de sbires --}}
            {{#if minions}}
                <div class="fq-play-field">
                    <label class="fq-play-label">{{localize "FQCARDENGINE.InvokeMinion"}}</label>
                    <div class="fq-play-minions">
                        <input class="fq-play-minion-cb" type="checkbox" name="minionUp"/>
                        <div class="fq-play-minion-row">
                            <input class="fq-play-minion-cb" type="checkbox" name="minionLeft"/>
                            <span class="fq-play-minion-center">
              <svg viewBox="0 0 14 16" fill="none" xmlns="http://www.w3.org/2000/svg" width="14" height="16">
                <circle cx="7" cy="4" r="3" stroke="currentColor" stroke-width="1.2"/>
                <path d="M1 15c0-3.314 2.686-6 6-6s6 2.686 6 6" stroke="currentColor" stroke-width="1.2"
                      stroke-linecap="round"/>
              </svg>
            </span>
                            <input class="fq-play-minion-cb" type="checkbox" name="minionRight"/>
                        </div>
                        <input class="fq-play-minion-cb" type="checkbox" name="minionDown"/>
                    </div>
                </div>
            {{/if}}

            {{!-- Compteur défausse --}}
            <div class="fq-play-label">
                {{localize "FQCARDENGINE.DropScore"}} : <strong>{{charStats.currentDrop}}</strong>
            </div>

        </form>

    </div>

</div>
