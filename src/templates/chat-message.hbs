<section class="fq-card-engine-message">
    <div class="fq-card-engine-message-card card" style="background-image:url('{{img}}')" title="{{name}}"
         data-img="{{img}}" data-card-id="{{id}}">
    </div>

    <div class="fq-card-engine-message-info">
        <h4 class="fq-card-engine-message-name"> {{#if action}}{{action}}: {{/if}}<b>{{name}}</b></h4>
    </div>
</section>
