<svg xmlns="http://www.w3.org/2000/svg"
     xmlns:xlink="http://www.w3.org/1999/xlink" viewBox="0 0 508 693">

    <defs>

        <!-- Background textures -->
        <radialGradient id="goldMana">
            <stop offset="0%" stop-color="#ffe7a3"></stop>
            <stop offset="100%" stop-color="#d29012"></stop>
        </radialGradient>

        <radialGradient id="blueMana">
            <stop offset="0%" stop-color="#c7ddf5"></stop>
            <stop offset="100%" stop-color="#7fa6cf"></stop>
        </radialGradient>

        <radialGradient id="redMana">
            <stop offset="0%" stop-color="#f06b6b"></stop>
            <stop offset="100%" stop-color="#7e2424"></stop>
        </radialGradient>

        <radialGradient id="whiteMana">
            <stop offset="0%" stop-color="#ffffff"></stop>
            <stop offset="100%" stop-color="#9f968d"></stop>
        </radialGradient>

        <radialGradient id="orangeMana">
            <stop offset="0%" stop-color="#ffffff"></stop>
            <stop offset="100%" stop-color="#ad5600"></stop>
        </radialGradient>

        <radialGradient id="greenMana">
            <stop offset="0%" stop-color="#ffffff"></stop>
            <stop offset="100%" stop-color="#1c7200"></stop>
        </radialGradient>

        <pattern id="neutral" patternUnits="userSpaceOnUse" width="500" height="700">
            <image href="modules/fq-card-engine/images/cards/texture/neutral.png" width="500"
                   height="700" preserveAspectRatio="none"/>
        </pattern>

        <pattern id="elementalist" patternUnits="userSpaceOnUse" width="500" height="700">
            <image href="modules/fq-card-engine/images/cards/texture/elementalist.png" x="0" y="0" width="500"
                   height="700" preserveAspectRatio="none"/>
        </pattern>

        <pattern id="guardian" patternUnits="userSpaceOnUse" width="500" height="700">
            <image href="modules/fq-card-engine/images/cards/texture/guardian.png" x="0" y="0" width="500"
                   height="700" preserveAspectRatio="none"/>
        </pattern>

        <pattern id="illusionist" patternUnits="userSpaceOnUse" width="500" height="700">
            <image href="modules/fq-card-engine/images/cards/texture/illusionist.png" x="0" y="0" width="500"
                   height="700" preserveAspectRatio="none"/>
        </pattern>

        <pattern id="monk" patternUnits="userSpaceOnUse" width="500" height="700">
            <image href="modules/fq-card-engine/images/cards/texture/monk.png" x="0" y="0" width="500"
                   height="700" preserveAspectRatio="none"/>
        </pattern>

        <pattern id="trapper" patternUnits="userSpaceOnUse" width="500" height="700">
            <image href="modules/fq-card-engine/images/cards/texture/trapper.png" x="0" y="0" width="500"
                   height="700" preserveAspectRatio="none"/>
        </pattern>
        <pattern id="white-mage" patternUnits="userSpaceOnUse" width="500" height="700">
            <image href="modules/fq-card-engine/images/cards/texture/white-mage.png" x="0" y="0" width="500"
                   height="700" preserveAspectRatio="none"/>
        </pattern>

        <pattern id="witch" patternUnits="userSpaceOnUse" width="500" height="700">
            <image href="modules/fq-card-engine/images/cards/texture/witch.png" x="0" y="0" width="500"
                   height="700" preserveAspectRatio="none"/>
        </pattern>

        <pattern id="{{ img }}"
                 patternUnits="userSpaceOnUse"
                 width="680"
                 height="400">

            <image href="{{ img }}"
                   width="450"
                   height="320"
                   x="60"
                   y="80"
                   preserveAspectRatio="none"/>
        </pattern>

        <clipPath id="socleClip">
            <rect x="138" y="360" width="347" height="45"/>
        </clipPath>

    </defs>

    <!-- Outer card -->
    <rect x="10" y="10" width="488" height="673" rx="34" fill="black" stroke="#2a2a2a"
          stroke-width="2"></rect>

    <!-- Header -->
    <rect x="24" y="20" width="460" height="70" rx="24" fill="url(#{{ fqClass }})"
          stroke="#1b1b1b"
          stroke-width="4"></rect>

    <!-- Title -->
    <foreignObject x="0" y="37" width="500" height="240">
        <div xmlns="http://www.w3.org/1999/xhtml"
             style="font-family: Lucida Calligraphy; font-style: italic; color: black;
                     font-size: {{ titleSize }}px; text-align: center;">
            {{ name }}
        </div>
    </foreignObject>

    <!-- Main black area -->
    <path d="
      M 40 95
      L 448 95
      Q 482 95 482 120
      L 482 375

      Q 482 400 432 400

      Q 402 400 375 400

      Q 314 400 304 400
      Q 296 400 262 400

      Q 105 400 220 400

      Q 100 400 195 400

      Q 0 400 195 400
      Q 30 192 40 95"
          fill="url(#{{ img }})" stroke="#4b4b4b" stroke-width="2"></path>

    <path fill-rule="evenodd" fill="black" clip-path="url(#socleClip)"
          d="M 138,357 L 485,357 L 585,402 L 138,402 Z
         M 138,357 A 42,38 0 1,0 222,357 A 42,38 0 1,0 138,357 Z
         M 226,360 A 42,38 0 1,0 310,360 A 42,38 0 1,0 226,360 Z
         M 313,360 A 42,38 0 1,0 397,360 A 42,38 0 1,0 313,360 Z
         M 401,358 A 42,38 0 1,0 485,358 A 42,38 0 1,0 401,358 Z"/>

    <!-- Green left triangle -->
    <path d="
      M 25 260
      Q 80 360 170 400
      L 25 400
      Z
    " fill="url(#{{ fqClass }})"></path>

    <!-- Green number square -->
    <g transform="translate(-75,300) rotate(25, 8, 300)">
        <rect width="44" height="68" rx="12"
              fill="url(#{{ fqClass }})" stroke="black" stroke-width="3"/>
    </g>
    <g transform="translate(-15,335) rotate(10, 81, 300)">
        <rect width="44" height="68" rx="12"
              fill="url(#{{ fqClass }})" stroke="black" stroke-width="3"/>
    </g>
    <g transform="translate(25,330) rotate(0, 81, 339)">
        <rect width="44" height="68" rx="12"
              fill="url(#{{ fqClass }})" stroke="black" stroke-width="4"/>
        <text x="21" y="40"
              text-anchor="middle"
              font-size="30"
              font-weight="700"
              font-family="Lucida Calligraphy"
              fill="black">{{maxSameCard}}
        </text>
    </g>

    <!-- Portée -->
    <circle cx="58" cy="135" r="42" fill="url(#whiteMana)" stroke="#1f1f1f" stroke-width="5"></circle>

    <circle cx="58" cy="142" r="14" fill="#736b63"></circle>

    <line x1="58" y1="99" x2="58" y2="173" stroke="#625b53" stroke-width="2"></line>

    <line x1="22" y1="137" x2="94" y2="137" stroke="#625b53" stroke-width="2"></line>

    {{#if reachMod}}
        <text x="56" y="142" text-anchor="middle" font-size="{{ reachSize }}" font-weight="700"
              font-family="Lucida Calligraphy"
              fill="green">

            {{ minReach }} |
            {{ maxReach }}
        </text>
    {{else}}
        <text x="56" y="142" text-anchor="middle" font-size="{{ reachSize }}" font-weight="700"
              font-family="Lucida Calligraphy"
              fill="black">

            {{ minReach }} |
            {{ maxReach }}
        </text>
    {{/if}}

    <!-- Points d'actions-->
    {{#if actionMod}}
        <circle cx="68" cy="222" r="42" fill="url(#goldMana)" stroke="#1f1f1f" stroke-width="5"></circle>
        <text x="66" y="230" text-anchor="middle" font-size="{{ actionSize }}" font-weight="700"
              font-family="Lucida Calligraphy"
              fill="green">
            {{ action }}
        </text>
    {{else}}
        <circle cx="68" cy="222" r="42" fill="url(#goldMana)" stroke="#1f1f1f" stroke-width="5"></circle>
        <text x="66" y="230" text-anchor="middle" font-size="{{ actionSize }}" font-weight="700"
              font-family="Lucida Calligraphy"
              fill="black">
            {{ action }}
        </text>
    {{/if}}

    <!-- Mana -->
    {{#if manaMod}}
        <circle cx="112" cy="298" r="42" fill="url(#blueMana)" stroke="#1f1f1f" stroke-width="6"></circle>
        <text x="110" y="306" text-anchor="middle" font-size="{{ manaSize }}" font-weight="700"
              font-family="Lucida Calligraphy"
              fill="green">
            {{ mana }}
        </text>
    {{else}}
        <circle cx="112" cy="298" r="42" fill="url(#blueMana)" stroke="#1f1f1f" stroke-width="6"></circle>
        <text x="110" y="306" text-anchor="middle" font-size="{{ manaSize }}" font-weight="700"
              font-family="Lucida Calligraphy"
              fill="black">
            {{ mana }}
        </text>
    {{/if}}

    <!-- Description -->
    <rect x="23" y="408" width="462" height="262" rx="14" fill="url(#{{ fqClass }})"
          stroke="black"
          stroke-width="5"></rect>

    <foreignObject x="23" y="404" width="462" height="266">
        <div xmlns="http://www.w3.org/1999/xhtml"
             style=" font-family: Lucida Calligraphy,serif; font-style: italic; font-size: {{ descriptionSize }}px;  color: black;
                     text-align: center; width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; white-space: pre-wrap;">
            <span>{{ description }}</span>
        </div>
    </foreignObject>


    <!-- Zèle -->
    {{#if zealMod}}
        <circle cx="180" cy="357" r="42" fill="url(#redMana)" stroke="#1f1f1f" stroke-width="6"></circle>
        <text x="179" y="366" text-anchor="middle" font-size="{{ zealSize }}" font-weight="700" font-family="Lucida Calligraphy"
              fill="green">
            {{ zeal }}
        </text>
    {{else}}
        <circle cx="180" cy="357" r="42" fill="url(#redMana)" stroke="#1f1f1f" stroke-width="6"></circle>
        <text x="179" y="366" text-anchor="middle" font-size="{{ zealSize }}" font-weight="700" font-family="Lucida Calligraphy"
              fill="black">
            {{ zeal }}
        </text>
    {{/if}}

    {{#if reactive }}
        <!-- Réactif -->
        <circle cx="268" cy="360" r="42" fill="url(#orangeMana)" stroke="#1f1f1f" stroke-width="6"></circle>

        <text x="265" y="372" text-anchor="middle" font-size="36" font-weight="700" font-family="Lucida Calligraphy"
              fill="black">
            R
        </text>
    {{/if}}

    {{#if replayable }}
        <!-- Passif -->
        {{#if replayableMod}}
            <circle cx="355" cy="360" r="42" fill="url(#greenMana)" stroke="#1f1f1f" stroke-width="6"></circle>
            <text x="353" y="372" text-anchor="middle" font-size="{{ replayableSize }}" font-weight="700" font-family="Lucida Calligraphy"
                  fill="green">
                {{ replayable }}
            </text>
        {{else}}
            <circle cx="355" cy="360" r="42" fill="url(#greenMana)" stroke="#1f1f1f" stroke-width="6"></circle>
            <text x="353" y="372" text-anchor="middle" font-size="{{ replayableSize }}" font-weight="700" font-family="Lucida Calligraphy"
                  fill="black">
                {{ replayable }}
            </text>
        {{/if}}
    {{/if}}
</svg>