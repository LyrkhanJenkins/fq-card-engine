<section class="tab cards{{#if tab.active}} active{{/if}}" data-group="{{tab.group}}" data-tab="{{tab.id}}">
    <header class="cards-header flexrow">
        <a class="control sort-mode" data-action="toggleSort" data-tooltip="CARDS.ACTIONS.ToggleSortMode">
            <span>({{cards.length}})</span>
            <i class="fa-solid fa-fw {{sortModeIcon}}"></i>
        </a>
        <strong class="name">{{localize "DOCUMENT.FIELDS.name.label"}}</strong>
        <span class="drawn">{{localize "FQCARDENGINE.CardLevel"}}</span>
        <span class="drawn">{{localize "FQCARDENGINE.MaxSameCardShort"}}</span>
        <span class="drawn">{{localize "FQCARDENGINE.CardFQBaseShort"}}</span>
        <span class="drawn">{{localize "CARD.FIELDS.drawn.label"}}</span>
        {{#if @root.user.isGM }}
            <span class="faces">{{localize "CARD.FIELDS.face.label"}}</span>
            <div class="controls">
                <a data-action="controlCard" data-control="create" data-tooltip="CARDS.ACTIONS.Create">
                    <i class="fa-solid fa-plus"></i>
                </a>
            </div>
        {{else if  @root.isYourDeck}}
            <div class="controls"></div>
        {{/if}}
    </header>
    <ol class="cards scrollable" data-cards>
        {{#each cards as |card|}}
            <li class="flexrow{{#if card.isMaxReached}} max-reached{{/if}}" data-card-id="{{card.id}}">
                {{#if @root.isYourSpellbook}}
                    <a class="move-left" data-action="fqMoveCardDeck" data-tooltip="FQCARDENGINE.MoveCardDeck"
                        {{disabled card.isMaxReached}}>
                        <i class="fa-solid fa-fw fa-2x fa-circle-arrow-left"></i>
                    </a>
                {{/if}}
                <img class="face fq-card-viewable" src="{{card.img}}" alt="{{localize card.name}}" loading="lazy"
                     data-action="fqViewCard" data-tooltip="FQCARDENGINE.ViewCard">
                <strong class="name">{{localize card.name}}</strong>
                <div class="drawn">{{card.system.fq.level}}</div>
                <div class="drawn">{{card.system.fq.maxSameCard}}</div>
                <div class="drawn">
                    <input type="checkbox" class="card-value" {{checked card.system.fq.isBase}} disabled>
                </div>
                <div class="drawn">
                    <input type="checkbox" class="value" {{checked card.drawn}} disabled>
                </div>
                {{#if @root.user.isGM}}
                    <div class="faces flexcol">
                        <a data-action="controlCard" data-control="nextFace" data-tooltip="CARDS.ACTIONS.NextFace"
                            {{disabled (not card.hasNextFace)}}>
                            <i class="fa-solid fa-caret-up"></i>
                        </a>
                        <a data-action="controlCard" data-control="prevFace" data-tooltip="CARDS.ACTIONS.PreviousFace"
                            {{disabled (not card.hasPreviousFace)}}>
                            <i class="fa-solid fa-caret-down"></i>
                        </a>
                    </div>
                    <div class="controls">
                        <a data-action="controlCard" data-control="edit" data-tooltip="CARDS.ACTIONS.Edit">
                            <i class="fa-solid fa-pen-to-square"></i>
                        </a>
                        {{#if @root.isYourDeck}}
                            <a data-action="fqDeleteCard" data-tooltip="CARDS.ACTIONS.Delete">
                                <i class="fa-solid fa-trash"></i>
                            </a>
                        {{else}}
                            <a data-action="controlCard" data-control="delete" data-tooltip="CARDS.ACTIONS.Delete">
                                <i class="fa-solid fa-trash"></i>
                            </a>
                        {{/if}}
                    </div>
                {{else if @root.isYourDeck}}
                    <div class="controls">
                        <a data-action="fqDeleteCard" data-tooltip="CARDS.ACTIONS.Delete">
                            <i class="fa-solid fa-trash"></i>
                        </a>
                    </div>
                {{/if}}
            </li>
        {{else}}
            <li>
                <p class="hint">{{localize "CARDS.NoCards"}}</p>
            </li>
        {{/each}}
    </ol>
</section>
