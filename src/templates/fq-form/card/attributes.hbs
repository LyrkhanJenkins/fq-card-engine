<section class="tab fq-form-attributes{{#if tab.active}} active{{/if}}" data-group="{{tab.group}}"
         data-tab="{{tab.id}}">

    <div class="form-fields">
        <label>{{localize "FQCARDENGINE.CardLevel"}}</label>
        {{formInput fields.fq.fields.level value=source.system.fq.level name="system.fq.level"
                    rootId=rootId}}
        <label>{{localize "FQCARDENGINE.MaxSameCard"}}</label>
        {{formInput fields.fq.fields.maxSameCard value=source.system.fq.maxSameCard name="system.fq.maxSameCard"
                    rootId=rootId}}
        <label>{{localize "FQCARDENGINE.CardFQBaseShort"}}</label>
        {{formInput fields.fq.fields.isBase value=source.system.fq.isBase name="system.fq.isBase"
                    rootId=rootId}}
        <label>{{localize "FQCARDENGINE.Class"}}</label>
        {{formInput fields.fq.fields.class value=source.system.fq.class name="system.fq.class"
                    rootId=rootId}}
    </div>
    {{#each source.system.fq.choices as |choice i|}}
        <fieldset data-choice data-index="{{i}}">
            <legend>
                {{#if (gt ../source.system.fq.choices.length 1)}}
                    <div class="form-fields">
                        <label>{{localize "FQCARDENGINE.ChoiceName"}}</label>
                        {{formInput ../fields.fq.fields.choices.element.fields.name value=choice.name
                                    name=(concat "system.fq.choices." i ".name") rootId=../rootId}}
                        <button type="button" class="remove-choice" data-action="removeChoice" data-index="{{i}}">❌
                            {{localize "FQCARDENGINE.DeleteChoice"}}
                        </button>
                    </div>
                {{else}}
                    <label>{{localize "FQCARDENGINE.CardEffect"}}</label>
                {{/if}}
            </legend>
            <fieldset>
                <legend>🧪 <label>{{localize "FQCARDENGINE.CardResources"}} </label></legend>
                <div class="form-fields">
                    <label>{{localize "FQCARDENGINE.ActionPoints"}}</label>
                    {{formInput ../fields.fq.fields.choices.element.fields.action value=choice.action
                                name=(concat "system.fq.choices." i ".action") rootId=../rootId}}

                    <label>{{localize "FQCARDENGINE.ManaPoints"}}</label>
                    {{formInput ../fields.fq.fields.choices.element.fields.mana value=choice.mana
                                name=(concat "system.fq.choices." i ".mana") rootId=../rootId}}

                    <label>{{localize "FQCARDENGINE.ZealPoints"}}</label>
                    {{formInput ../fields.fq.fields.choices.element.fields.zeal value=choice.zeal
                                name=(concat "system.fq.choices." i ".zeal") rootId=../rootId}}
                    <label>{{localize "FQCARDENGINE.ReactiveCard"}}</label>
                    {{formInput ../fields.fq.fields.choices.element.fields.reactive value=choice.reactive
                                name=(concat "system.fq.choices." i ".reactive") rootId=../rootId}}
                </div>
                <div class="form-fields">
                    <label>{{localize "FQCARDENGINE.HpModifier"}}</label>
                    {{formInput ../fields.fq.fields.choices.element.fields.hp value=choice.hp
                                name=(concat "system.fq.choices." i ".hp") rootId=../rootId}}

                    <label>{{localize "FQCARDENGINE.Draw"}}</label>
                    {{formInput ../fields.fq.fields.choices.element.fields.draw value=choice.draw
                                name=(concat "system.fq.choices." i ".draw") rootId=../rootId}}

                    <label>{{localize "FQCARDENGINE.Drop"}}</label>
                    {{formInput ../fields.fq.fields.choices.element.fields.drop value=choice.drop
                                name=(concat "system.fq.choices." i ".drop") rootId=../rootId}}
                </div>
            </fieldset>
            <fieldset>
                <legend>🎯 <label>{{localize "FQCARDENGINE.CardTargeting"}} </label></legend>
                <div class="form-fields">
                    <label>{{localize "FQCARDENGINE.TargetType"}}</label>
                    {{formInput ../fields.fq.fields.choices.element.fields.targetType value=choice.targetType
                                name=(concat "system.fq.choices." i ".targetType") rootId=../rootId}}

                    <label>{{localize "FQCARDENGINE.MinReach"}}</label>
                    {{formInput ../fields.fq.fields.choices.element.fields.minReach value=choice.minReach
                                name=(concat "system.fq.choices." i ".minReach") rootId=../rootId}}

                    <label>{{localize "FQCARDENGINE.MaxReach"}}</label>
                    {{formInput ../fields.fq.fields.choices.element.fields.maxReach value=choice.maxReach
                                name=(concat "system.fq.choices." i ".maxReach") rootId=../rootId}}

                    <label>{{localize "FQCARDENGINE.NbTargets"}}</label>
                    {{formInput ../fields.fq.fields.choices.element.fields.nbTargets value=choice.nbTargets
                                name=(concat "system.fq.choices." i ".nbTargets") rootId=../rootId}}
                </div>
                <div class="form-fields">
                    <label>{{localize "FQCARDENGINE.Damage"}}</label>
                    {{formInput ../fields.fq.fields.choices.element.fields.damage value=choice.damage
                                name=(concat "system.fq.choices." i ".damage") rootId=../rootId}}

                    <label>{{localize "FQCARDENGINE.Heal"}}</label>
                    {{formInput ../fields.fq.fields.choices.element.fields.heal value=choice.heal
                                name=(concat "system.fq.choices." i ".heal") rootId=../rootId}}
                </div>
                <div class="form-fields">

                    <label>{{localize "FQCARDENGINE.BonusCrit"}}</label>
                    {{formInput ../fields.fq.fields.choices.element.fields.bonusCrit value=choice.bonusCrit
                                name=(concat "system.fq.choices." i ".bonusCrit") rootId=../rootId}}

                    <label>{{localize "FQCARDENGINE.BonusEva"}}</label>
                    {{formInput ../fields.fq.fields.choices.element.fields.bonusEva value=choice.bonusEva
                                name=(concat "system.fq.choices." i ".bonusEva") rootId=../rootId}}
                </div>
            </fieldset>
            <fieldset>
                <legend>🔨 <label>{{localize "FQCARDENGINE.AttributeModifiers"}} </label></legend>
                <div class="form-fields">
                    <label>{{localize "FQCARDENGINE.Xmin"}}</label>
                    {{formInput ../fields.fq.fields.choices.element.fields.xmin value=choice.xmin
                                name=(concat "system.fq.choices." i ".xmin") rootId=../rootId}}

                    <label>{{localize "FQCARDENGINE.Xmax"}}</label>
                    {{formInput ../fields.fq.fields.choices.element.fields.xmax value=choice.xmax
                                name=(concat "system.fq.choices." i ".xmax") rootId=../rootId}}

                    <label>{{localize "FQCARDENGINE.Ymin"}}</label>
                    {{formInput ../fields.fq.fields.choices.element.fields.ymin value=choice.ymin
                                name=(concat "system.fq.choices." i ".ymin") rootId=../rootId}}

                    <label>{{localize "FQCARDENGINE.Ymax"}}</label>
                    {{formInput ../fields.fq.fields.choices.element.fields.ymax value=choice.ymax
                                name=(concat "system.fq.choices." i ".ymax") rootId=../rootId}}
                </div>
                <div class="form-fields">

                    <label>{{localize "FQCARDENGINE.Xvalue"}}</label>
                    {{formInput ../fields.fq.fields.choices.element.fields.xvalue value=choice.xvalue
                                name=(concat "system.fq.choices." i ".xvalue") rootId=../rootId}}
                </div>
                <div class="form-fields">

                    <label>{{localize "FQCARDENGINE.Yvalue"}}</label>
                    {{formInput ../fields.fq.fields.choices.element.fields.yvalue value=choice.yvalue
                                name=(concat "system.fq.choices." i ".yvalue") rootId=../rootId}}
                </div>
            </fieldset>
            <fieldset>
                <!-- Liste des formules d'effets -->
                <legend>‍✨ <label>{{localize "FQCARDENGINE.ApplyEffectsFormulas"}} </label></legend>
                {{#each choice.applyEffectsFormulas as | applyEffectsFormula formulaIndex|}}
                    <fieldset data-adding-formula-effects>
                        <legend>
                            <button type="button" data-action="removeEffectsFormula"
                                    data-index="{{i}}" data-formula-index="{{formulaIndex}}">❌
                            </button>
                        </legend>
                        <div class="form-fields">
                            <label>{{localize "FQCARDENGINE.FormulaTitle"}}</label>
                            {{formInput
                                ../../fields.fq.fields.choices.element.fields.applyEffectsFormulas.element.fields.title
                                value=applyEffectsFormula.title
                                name=(concat "system.fq.choices." i ".applyEffectsFormulas." formulaIndex ".title")
                                rootId=../../rootId
                            }}
                            <label>{{localize "FQCARDENGINE.Formula"}}</label>
                            {{formInput
                                ../../fields.fq.fields.choices.element.fields.applyEffectsFormulas.element.fields.formula
                                value=applyEffectsFormula.formula
                                name=(concat "system.fq.choices." i ".applyEffectsFormulas." formulaIndex ".formula")
                                rootId=../../rootId
                            }}
                        </div>
                        {{#each applyEffectsFormula.effects as |effect effectIndex|}}
                            <fieldset data-formula-effect>
                                <legend class="effect-legend">
                                    <button type="button"
                                            data-action="removeFormulaEffect"
                                            data-index="{{i}}" data-formula-index="{{formulaIndex}}"
                                            data-effect-index="{{effectIndex}}">❌
                                    </button>
                                    {{formInput
                                        ../../../fields.fq.fields.choices.element.fields.applyEffectsFormulas.element.fields.effects.element.fields.result
                                        value=effect.result
                                        name=(concat "system.fq.choices." i ".applyEffectsFormulas." formulaIndex ".effects." effectIndex ".result")
                                        rootId=../../../rootId
                                    }}
                                    <label>{{localize "FQCARDENGINE.SelfApplyEffect"}}</label>
                                    {{formInput
                                        ../../../fields.fq.fields.choices.element.fields.applyEffectsFormulas.element.fields.effects.element.fields.self
                                        value=effect.self
                                        name=(concat "system.fq.choices." i ".applyEffectsFormulas." formulaIndex ".effects." effectIndex ".self")
                                        rootId=../../../rootId
                                    }}
                                </legend>
                                <div class="form-fields">
                                    <label>{{localize "FQCARDENGINE.RemoveEffectName"}}</label>
                                    {{formInput
                                        ../../../fields.fq.fields.choices.element.fields.applyEffectsFormulas.element.fields.effects.element.fields.removeEffectName
                                        value=effect.removeEffectName
                                        name=(concat "system.fq.choices." i ".applyEffectsFormulas." formulaIndex ".effects." effectIndex ".removeEffectName")
                                        rootId=../../../rootId
                                    }}
                                </div>
                                <button type="button" data-action="addDataEffect" data-index="{{i}}"
                                        data-formula-index="{{formulaIndex}}" data-effect-index="{{effectIndex}}">
                                    ➕ {{localize
                                    "FQCARDENGINE.AddDataEffect"}}</button>
                                {{#each effect.data as |dat dataIndex|}}
                                    <fieldset data-add-data-effect>
                                        <legend>
                                            <button type="button"
                                                    data-action="removeDataEffect"
                                                    data-index="{{i}}" data-formula-index="{{formulaIndex}}"
                                                    data-effect-index="{{effectIndex}}" data-data-index="{{dataIndex}}">
                                                ❌
                                            </button>
                                        </legend>
                                        <div class="form-fields">
                                            <label>{{localize "FQCARDENGINE.EffectLabel"}}</label>
                                            <span class="fq-w-3xl">
                                                {{formInput
                                                    ../../../../fields.fq.fields.choices.element.fields.applyEffectsFormulas.element.fields.effects.element.fields.data.element.fields.name
                                                    value=dat.name
                                                    name=(concat "system.fq.choices." i ".applyEffectsFormulas." formulaIndex ".effects." effectIndex ".data." dataIndex ".name")
                                                    rootId=../../../../rootId
                                                }}
                                            </span>
                                            <label>{{localize "FQCARDENGINE.EffectIcon"}}</label>
                                            {{formInput
                                                ../../../../fields.fq.fields.choices.element.fields.applyEffectsFormulas.element.fields.effects.element.fields.data.element.fields.img
                                                value=dat.img
                                                name=(concat "system.fq.choices." i ".applyEffectsFormulas." formulaIndex ".effects." effectIndex ".data." dataIndex ".img")
                                                rootId=../../../../rootId
                                            }}
                                        </div>
                                        {{#each dat.changes as |change changeIndex|}}
                                            <div class="form-fields" data-add-data-effect-change>
                                                <button type="button"
                                                        data-action="removeChangeData"
                                                        data-index="{{i}}" data-formula-index="{{formulaIndex}}"
                                                        data-effect-index="{{effectIndex}}"
                                                        data-data-index="{{dataIndex}}"
                                                        data-change-index="{{changeIndex}}">❌
                                                </button>
                                                <label>{{localize "FQCARDENGINE.EffectChangeKey"}}</label>
                                                {{formInput
                                                    ../../../../../fields.fq.fields.choices.element.fields.applyEffectsFormulas.element.fields.effects.element.fields.data.element.fields.changes.element.fields.key
                                                    value=change.key
                                                    name=(concat "system.fq.choices." i ".applyEffectsFormulas." formulaIndex ".effects." effectIndex ".data." dataIndex ".changes." changeIndex ".key")
                                                    rootId=../../../../../rootId
                                                }}
                                                <label>{{localize "FQCARDENGINE.EffectChangeValue"}}</label>
                                                <div class="fq-w-m">
                                                    {{formInput
                                                        ../../../../../fields.fq.fields.choices.element.fields.applyEffectsFormulas.element.fields.effects.element.fields.data.element.fields.changes.element.fields.value
                                                        value=change.value
                                                        name=(concat "system.fq.choices." i ".applyEffectsFormulas." formulaIndex ".effects." effectIndex ".data." dataIndex ".changes." changeIndex ".value")
                                                        rootId=../../../../../rootId
                                                    }}
                                                </div>
                                                <label>{{localize "FQCARDENGINE.EffectChangeType"}}</label>
                                                <div class="fq-w-l">
                                                    {{formInput
                                                        ../../../../../fields.fq.fields.choices.element.fields.applyEffectsFormulas.element.fields.effects.element.fields.data.element.fields.changes.element.fields.type
                                                        value=change.type
                                                        name=(concat "system.fq.choices." i ".applyEffectsFormulas." formulaIndex ".effects." effectIndex ".data." dataIndex ".changes." changeIndex ".type")
                                                        rootId=../../../../../rootId
                                                    }}
                                                </div>
                                                <label>{{localize "FQCARDENGINE.EffectChangePriority"}}</label>
                                                <div class="fq-w-s">
                                                    {{formInput
                                                        ../../../../../fields.fq.fields.choices.element.fields.applyEffectsFormulas.element.fields.effects.element.fields.data.element.fields.changes.element.fields.priority
                                                        value=change.priority
                                                        name=(concat "system.fq.choices." i ".applyEffectsFormulas." formulaIndex ".effects." effectIndex ".data." dataIndex ".changes." changeIndex ".priority")
                                                        rootId=../../../../../rootId
                                                    }}
                                                </div>
                                            </div>
                                        {{/each}}
                                        <button type="button" data-action="addChangeData" data-index="{{i}}"
                                                data-formula-index="{{formulaIndex}}"
                                                data-effect-index="{{effectIndex}}"
                                                data-data-index="{{dataIndex}}">➕ {{localize
                                            "FQCARDENGINE.AddChangeData"}}</button>
                                        <div data-add-data-effect>

                                            <div class="form-fields">
                                                <label>{{localize "FQCARDENGINE.EffectDurationValue"}}</label>
                                                {{formInput
                                                    ../../../../fields.fq.fields.choices.element.fields.applyEffectsFormulas.element.fields.effects.element.fields.data.element.fields.duration.fields.value
                                                    value=dat.duration.value
                                                    name=(concat "system.fq.choices." i ".applyEffectsFormulas." formulaIndex ".effects." effectIndex ".data." dataIndex ".duration.value")
                                                    rootId=../../../../rootId
                                                }}
                                                <label>{{localize "FQCARDENGINE.EffectDurationUnits"}}</label>
                                                {{formInput
                                                    ../../../../fields.fq.fields.choices.element.fields.applyEffectsFormulas.element.fields.effects.element.fields.data.element.fields.duration.fields.units
                                                    value=dat.duration.units
                                                    name=(concat "system.fq.choices." i ".applyEffectsFormulas." formulaIndex ".effects." effectIndex ".data." dataIndex ".duration.units")
                                                    localize=true
                                                    rootId=../../../../rootId
                                                }}
                                                <label>{{localize "FQCARDENGINE.EffectExpireOnDamage"}}</label>
                                                {{formInput
                                                    ../../../../fields.fq.fields.choices.element.fields.applyEffectsFormulas.element.fields.effects.element.fields.data.element.fields.expireOnDamage
                                                    value=dat.expireOnDamage
                                                    name=(concat "system.fq.choices." i ".applyEffectsFormulas." formulaIndex ".effects." effectIndex ".data." dataIndex ".expireOnDamage")
                                                    rootId=../../../../rootId
                                                }}
                                            </div>
                                            <div class="form-fields">
                                                <label>{{localize "FQCARDENGINE.EffectShowIcon"}}</label>
                                                {{formInput
                                                    ../../../../fields.fq.fields.choices.element.fields.applyEffectsFormulas.element.fields.effects.element.fields.data.element.fields.showIcon
                                                    value=dat.showIcon
                                                    name=(concat "system.fq.choices." i ".applyEffectsFormulas." formulaIndex ".effects." effectIndex ".data." dataIndex ".showIcon")
                                                    localize=true
                                                    rootId=../../../../rootId
                                                }}
                                            </div>
                                        </div>
                                    </fieldset>
                                {{/each}}
                                {{#each effect.messages as |effectMessage effectMessageIndex|}}
                                    <div class="form-fields" data-effect-message>
                                        <label>{{localize "FQCARDENGINE.MessageKey"}}</label>
                                        {{formInput
                                            ../../../../fields.fq.fields.choices.element.fields.applyEffectsFormulas.element.fields.effects.element.fields.messages.element.fields.key
                                            value=effectMessage.key
                                            name=(concat "system.fq.choices." i ".applyEffectsFormulas." formulaIndex ".effects." effectIndex ".messages." effectMessageIndex ".key")
                                            rootId=../../../../rootId
                                        }}
                                        <label>{{localize "FQCARDENGINE.MessageArg"}}</label>
                                        {{formInput
                                            ../../../../fields.fq.fields.choices.element.fields.applyEffectsFormulas.element.fields.effects.element.fields.messages.element.fields.arg
                                            value=effectMessage.arg
                                            elementType="textarea"
                                            name=(concat "system.fq.choices." i ".applyEffectsFormulas." formulaIndex ".effects." effectIndex ".messages." effectMessageIndex ".arg")
                                            rootId=../../../../rootId
                                        }}
                                        <button type="button" data-action="removeEffectMessage" data-index="{{i}}"
                                                data-formula-index="{{formulaIndex}}"
                                                data-effect-index="{{effectIndex}}"
                                                data-effect-message-index="{{effectMessageIndex}}">❌
                                        </button>
                                    </div>
                                {{/each}}
                                <button type="button" data-action="addEffectMessage" data-index="{{i}}"
                                        data-formula-index="{{formulaIndex}}" data-effect-index="{{effectIndex}}">
                                    ➕ {{localize
                                    "FQCARDENGINE.AddAdditionalMessage"}}</button>
                            </fieldset>
                        {{/each}}
                        <button type="button" data-action="addFormulaEffect" data-index="{{i}}"
                                data-formula-index="{{formulaIndex}}">➕ {{localize
                            "FQCARDENGINE.AddFormulaEffect"}}</button>
                    </fieldset>
                {{/each}}
                <button type="button" data-action="addEffectsFormula" data-index="{{i}}">➕ {{localize
                    "FQCARDENGINE.AddEffectsFormula"}}</button>
            </fieldset>
            <fieldset>
                <!-- Liste des messages additionnels -->
                <legend>💬 <label>{{localize "FQCARDENGINE.AddingMessages"}} </label></legend>
                {{#each choice.messages as |message messageIndex|}}
                    <div class="form-fields" data-adding-message>
                        <label>{{localize "FQCARDENGINE.MessageKey"}}</label>
                        {{formInput
                            ../../fields.fq.fields.choices.element.fields.messages.element.fields.key
                            value=message.key
                            name=(concat "system.fq.choices." i ".messages." messageIndex ".key")
                            rootId=../../rootId
                        }}
                        <label>{{localize "FQCARDENGINE.MessageArg"}}</label>
                        {{formInput
                            ../../fields.fq.fields.choices.element.fields.messages.element.fields.arg
                            value=message.arg
                            elementType="textarea"
                            name=(concat "system.fq.choices." i ".messages." messageIndex ".arg")
                            rootId=../../rootId
                        }}
                        <button type="button" data-action="removeAdditionalMessage"
                                data-index="{{i}}" data-message-index="{{messageIndex}}">❌
                        </button>
                    </div>
                {{/each}}
                <button type="button" data-action="addAdditionalMessage" data-index="{{i}}">➕ {{localize
                    "FQCARDENGINE.AddAdditionalMessage"}}</button>


            </fieldset>
            <fieldset>
                <!-- Liste des sbires -->
                <legend>🐺 <label>{{localize "FQCARDENGINE.Minions"}} </label></legend>
                {{#each choice.minions as |minion minionIndex|}}
                    <fieldset data-minion>
                        <div class="form-fields">
                            <label>{{localize "FQCARDENGINE.MinionName"}}</label>
                            {{formInput
                                ../../fields.fq.fields.choices.element.fields.minions.element.fields.name
                                value=minion.name
                                name=(concat "system.fq.choices." i ".minions." minionIndex ".name")
                                rootId=../../rootId
                            }}
                            <button type="button" data-action="removeMinion"
                                    data-index="{{i}}" data-minion-index="{{minionIndex}}">❌
                            </button>
                        </div>
                        <div class="form-fields">
                            <label>{{localize "FQCARDENGINE.MinionHp"}}</label>
                            {{formInput
                                ../../fields.fq.fields.choices.element.fields.minions.element.fields.data.fields.hp
                                value=minion.data.hp
                                name=(concat "system.fq.choices." i ".minions." minionIndex ".data.hp")
                                rootId=../../rootId
                            }}
                            <label>{{localize "FQCARDENGINE.MinionDamageBonus"}}</label>
                            {{formInput
                                ../../fields.fq.fields.choices.element.fields.minions.element.fields.data.fields.damageBonus
                                value=minion.data.damageBonus
                                name=(concat "system.fq.choices." i ".minions." minionIndex ".data.damageBonus")
                                rootId=../../rootId
                            }}
                            <label>{{localize "FQCARDENGINE.MinionMovement"}}</label>
                            {{formInput
                                ../../fields.fq.fields.choices.element.fields.minions.element.fields.data.fields.movement
                                value=minion.data.movement
                                name=(concat "system.fq.choices." i ".minions." minionIndex ".data.movement")
                                rootId=../../rootId
                            }}
                        </div>
                    </fieldset>
                {{/each}}
                <button type="button" data-action="addMinion" data-index="{{i}}">➕ {{localize
                    "FQCARDENGINE.AddMinion"}}</button>
            </fieldset>

            <fieldset>
                <!-- Liste des messages additionnels -->
                <legend>📓 <label>{{localize "FQCARDENGINE.CustomEvals"}} </label></legend>
                {{#each choice.customEvals as |customEval customEvalIndex|}}
                    <fieldset data-custom-eval>
                        <legend>
                            <button type="button" data-action="removeCustomEval"
                                    data-index="{{i}}" data-custom-eval-index="{{customEvalIndex}}">❌
                            </button>
                        </legend>
                        <label>{{localize "FQCARDENGINE.CustomEvalScript"}}</label>
                        <div class="form-fields">
                            {{formInput
                                ../../fields.fq.fields.choices.element.fields.customEvals.element.fields.script
                                value=customEval.script
                                elementType="textarea"
                                name=(concat "system.fq.choices." i ".customEvals." customEvalIndex ".script")
                                rootId=../../rootId
                            }}
                        </div>
                        <label>{{localize "FQCARDENGINE.CustomEvalErrorMessages"}}</label>
                        {{#each customEval.errorMessages as |errorMessage errorMessageIndex|}}
                            <div class="form-fields" data-custom-eval-error-message>
                                <label>{{localize "FQCARDENGINE.MessageKey"}}</label>
                                {{formInput
                                    ../../../fields.fq.fields.choices.element.fields.customEvals.element.fields.errorMessages.element.fields.key
                                    value=errorMessage.key
                                    name=(concat "system.fq.choices." i ".customEvals." customEvalIndex ".errorMessages." errorMessageIndex ".key")
                                    rootId=../../../rootId
                                }}
                                <label>{{localize "FQCARDENGINE.MessageArg"}}</label>
                                {{formInput
                                    ../../../fields.fq.fields.choices.element.fields.customEvals.element.fields.errorMessages.element.fields.arg
                                    value=errorMessage.arg
                                    elementType="textarea"
                                    name=(concat "system.fq.choices." i ".customEvals." customEvalIndex ".errorMessages." errorMessageIndex ".arg")
                                    rootId=../../../rootId
                                }}
                                <button type="button" data-action="removeCustomEvalErrorMessage"
                                        data-index="{{i}}" data-custom-eval-index="{{customEvalIndex}}"
                                        data-error-message-index="{{errorMessageIndex}}">❌
                                </button>
                            </div>
                        {{/each}}
                        <button type="button" data-action="addCustomEvalErrorMessage" data-index="{{i}}"
                                data-custom-eval-index="{{customEvalIndex}}">➕ {{localize
                            "FQCARDENGINE.AddAdditionalMessage"}}</button>
                    </fieldset>
                {{/each}}
                <button type="button" data-action="addCustomEval" data-index="{{i}}">➕ {{localize
                    "FQCARDENGINE.AddCustomEval"}}</button>
            </fieldset>
            <fieldset>
                <legend>📜 <label>{{localize "FQCARDENGINE.OtherCardAttributes"}} </label></legend>
                <div class="form-fields">
                    <label>{{localize "FQCARDENGINE.Replayable"}}</label>
                    {{formInput ../fields.fq.fields.choices.element.fields.replayable value=choice.replayable
                                name=(concat "system.fq.choices." i ".replayable") rootId=../rootId}}
                    <label>{{localize "FQCARDENGINE.CardSound"}}</label>
                    {{formInput ../fields.fq.fields.choices.element.fields.sound value=choice.sound
                                name=(concat "system.fq.choices." i ".sound") rootId=../rootId}}
                </div>
                <div class="form-fields">
                    <label>{{localize "FQCARDENGINE.CardVisual"}}</label>
                    {{formInput ../fields.fq.fields.choices.element.fields.visual.fields.path value=choice.visual.path
                                name=(concat "system.fq.choices." i ".visual.path") rootId=../rootId}}
                    <label>{{localize "FQCARDENGINE.CardVisualOnTarget"}}</label>
                    {{formInput ../fields.fq.fields.choices.element.fields.visual.fields.onTarget
                                value=choice.visual.onTarget
                                name=(concat "system.fq.choices." i ".visual.onTarget") rootId=../rootId}}

                </div>
                <div class="form-fields">
                    <label>{{localize "FQCARDENGINE.NewFQSystemAfterFirstPlay"}}</label>
                    {{formInput ../fields.fq.fields.choices.element.fields.afterFirstPlay value=choice.afterFirstPlay
                                elementType="textarea"
                                name=(concat "system.fq.choices." i ".afterFirstPlay") rootId=../rootId}}
                </div>
            </fieldset>
        </fieldset>
    {{/each}}
    <button type="button" class="add-choice" data-action="addChoice">➕ {{localize "FQCARDENGINE.AddChoice"}}</button>
</section>
